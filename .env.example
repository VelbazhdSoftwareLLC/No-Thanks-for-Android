# Google Play Store credentials
# Copy this file to .env and fill in your actual values

# Keystore passwords for signing the release APK
KEYSTORE_PASSWORD=your_keystore_password_here
KEY_ALIAS=your_key_alias_here
KEY_PASSWORD=your_key_password_here

# Google Play Store JSON key file path (optional)
GOOGLE_PLAY_JSON_KEY_PATH=./fastlane/google-play-service-account.json
